package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_defaults {
    name: "com.android.hardware.security.see.hwcrypto.apex_defaults",
    manifest: "manifest.json",
    key: "com.google.trusty-qemu.apex.key",
    certificate: ":com.google.trusty-qemu.apex.certificate",
    proprietary: true,
    updatable: false,
    file_contexts: "file_contexts",
}

// The following apex is used when keymint runs in the TEE. In this case
// HwCrypto HAL do not register an ISharedSecret service, because keymint is in
// charge of doing it.
apex {
    name: "com.android.hardware.security.see.hwcrypto.trusty_tee.without_shared_secret",
    defaults: ["com.android.hardware.security.see.hwcrypto.apex_defaults"],
    init_rc: ["com.android.hardware.security.see.hwcrypto.without_shared_secret.rc"],
}

// The following apex is used when keymint runs as part of the security VM. In
// This case HwCrypto HAL register an ISharedSecret service.
apex {
    name: "com.android.hardware.security.see.hwcrypto.trusty_tee.shared_secret",
    defaults: ["com.android.hardware.security.see.hwcrypto.apex_defaults"],
    init_rc: ["com.android.hardware.security.see.hwcrypto.shared_secret.rc"],
    prebuilts: [
        // vintf fragments
        "android.hardware.security.see.hwcrypto.sharedsecret-service.trusty.xml",
    ],
}
