package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "memshare_app.defaults",
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder",
        "libbinder_ndk",
        "libutils",
        "android.trusty.cmdprocessor-cpp",
        "android.trusty.membuf-cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    visibility: [
        "//vendor:__subpackages__", // for vendor use
    ],
}

cc_binary {
    name: "memshare_app.system",
    defaults: [
        "memshare_app.defaults",
    ],
    srcs: [
        "main.cpp",
    ],
    system_ext_specific: true,
}
