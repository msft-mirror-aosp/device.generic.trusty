# TODO(b/393848753): determine whether task_profiles shall be defined
service trusty_vendor_memshare_vm_launcher /vendor/bin/memshare_trusty_vm_launcher_vendor \
--name vendor_memshare_vm \
--kernel /vendor/etc/vm/trusty_vm/trusty_memshare_vm.elf \
--rpc-services-config /vendor/etc/vm/trusty_vm/memshare_vm_rpc_services.json \
--memory-size-mib 32 \
--protected
    class hal
    user root
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
    stdio_to_kmsg
    oneshot
    interface aidl android.os.IAccessor/ICommandProcessor/memshare_vm
    interface aidl android.os.IAccessor/IMemoryBufferShareVm/memshare_vm
