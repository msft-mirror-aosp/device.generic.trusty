# TODO(b/393848753): determine whether task_profiles shall be defined
service trusty_memshare_vm_launcher /system_ext/bin/memshare_trusty_vm_launcher_system \
--name memshare_vm \
--kernel /system_ext/etc/vm/trusty_vm/trusty_memshare_vm.elf \
--rpc-services-config /system_ext/etc/vm/trusty_vm/memshare_vm_rpc_services.json \
--vm-instance-id /system_ext/etc/vm/trusty_vm/memshare_vm_instance_id \
--memory-size-mib 32 \
--protected
    class hal
    user root
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE IPC_OWNER
    stdio_to_kmsg
    oneshot
    # task_profiles MaxPerformance
    interface aidl android.os.IAccessor/ICommandProcessor/memshare_vm
    interface aidl android.os.IAccessor/IMemoryBufferShareVm/memshare_vm
