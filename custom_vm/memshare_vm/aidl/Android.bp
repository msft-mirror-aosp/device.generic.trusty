package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "android.trusty.membuf",
    host_supported: true,
    srcs: [
        "android/trusty/membuf/*.aidl",
    ],
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    unstable: true,
    vendor_available: true,
    owner: "aosp",
    visibility: [
        "//system/tools/aidl/build",
        "//device/generic/trusty/custom_vm:__subpackages__",
        "//vendor:__subpackages__", // for vendor use
    ],
}

aidl_interface {
    name: "android.trusty.cmdprocessor",
    host_supported: true,
    srcs: [
        "android/trusty/cmdprocessor/*.aidl",
    ],
    imports: [
        "android.trusty.membuf",
    ],
    backend: {
        java: {
            enabled: false,
        },
        cpp: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
    },
    unstable: true,
    vendor_available: true,
    owner: "aosp",
    frozen: false,
    visibility: [
        "//system/tools/aidl/build",
        "//device/generic/trusty/custom_vm:__subpackages__",
        "//vendor:__subpackages__", // for vendor use,
    ],
}

cc_defaults {
    name: "android.trusty.cmdprocessor_latest_cpp",
    shared_libs: [
        "android.trusty.cmdprocessor-cpp",
    ],
    visibility: [
        "//vendor:__subpackages__", // for vendor use
    ],
}
