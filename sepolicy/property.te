# Trusty storage FS ready
vendor_internal_prop(vendor_trusty_storage_prop)

# This prop will be set to "mounted" after /mnt/vendor/persist mounts
vendor_internal_prop(vendor_persist_prop)

# Slots mock IBootControl uses and whether they're active/booted successfully
vendor_internal_prop(vendor_mock_boot_props)

# Enable ISharedSecret/hwcrypto HAL backed by HwCrypto
vendor_internal_prop(vendor_hwcryptohal_prop)
